<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Видео-заставка (standby.dart) читает файлы напрямую с SD-карты
         из произвольной папки /vid — не через MediaStore/DCIM и с
         нестандартным расширением (.lmxb), поэтому обычных READ_MEDIA_*
         недостаточно. MANAGE_EXTERNAL_STORAGE даёт прямой доступ к файлам
         независимо от расширения/типа — оправдано для полностью
         контролируемого киоск-терминала (не Play Store приложение). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Автозапуск после подачи питания (Шаг 32, задача 1) — терминал стоит
         на улице без оператора рядом. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Рестарт после аварии (Шаг 32, задача 4) — setAlarmClock() требует
         точных будильников, зато (в отличие от обычного неточного
         будильника) реально пробивает ограничение на старт активности из
         фона мёртвого процесса — проверено вживую. На Android 13 разрешение
         выдаётся автоматически при установке; на Android 14+ для приложений
         с targetSdk 34+ может понадобиться разовое подтверждение через
         системные настройки. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <application
        android:label="dry_fog_app"
        android:name=".DryFogApplication"
        android:icon="@mipmap/ic_launcher">
        <!-- launchMode singleInstance (задача "приложение остаётся в фоне
             при холодном старте") — MainActivity достижима тремя разными
             путями (обычный LAUNCHER intent-filter здесь, роль домашнего
             экрана через KioskHomeAlias ниже, явный запуск из
             BootReceiver), и на холодном старте после полного обесточивания
             (в отличие от программной перезагрузки) эти пути могут
             сработать почти одновременно, порождая два раздельных
             экземпляра активности в разных task-стеках — тогда системе
             физически не из чего выбирать, какой из них поднять на
             передний план. singleInstance гарантирует ровно один экземпляр
             в собственной задаче независимо от того, через какой intent
             его вызвали — любой повторный запуск маршрутизируется в уже
             существующий (onNewIntent), а не создаёт второй. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Псевдоним для роли домашнего экрана (Шаг 32, задача 2). Отдельный
             компонент, а не второй intent-filter на MainActivity, потому что
             задача 3 включает/выключает именно роль "домашний экран" через
             PackageManager во время работы, не трогая обычный запуск из
             списка приложений. Выключен по умолчанию: свежая сборка не
             должна внезапно захватывать роль рабочего стола на планшете
             разработчика — включается только тумблером "Киоск-режим" в
             сервисном меню. -->
        <activity-alias
            android:name=".KioskHomeAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity-alias>

        <!-- Автозапуск после перезагрузки/подачи питания (Шаг 32, задача 1).
             exported=true обязателен, иначе система не сможет его вызвать —
             сами системные широковещательные сообщения BOOT_COMPLETED
             защищены (protected broadcast), отправить их может только
             система, так что экспорт здесь не открывает дыру. directBootAware
             нужен, чтобы приёмник вообще получал LOCKED_BOOT_COMPLETED. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <!-- Рестарт после аварии (Шаг 32, задача 4) — только по собственному
             PendingIntent из AlarmManager, извне не вызывается. -->
        <receiver
            android:name=".RestartReceiver"
            android:exported="false"/>

        <!-- Восстанавливает роль домашнего экрана после обновления APK
             (Шаг 32, задача 3) — Android сбрасывает вручную выставленный
             enabled-статус KioskHomeAlias обратно к манифестному при замене
             пакета, проверено вживую. MY_PACKAGE_REPLACED — защищённая
             системная рассылка, доставляется только самому приложению. -->
        <receiver
            android:name=".PackageUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
